public def checks : List (String × Bool) :=
  [ ("CAVP SigVer15 2048/SHA-256 case A1, Result = P",
      verify keyA (bytesOfHex messageA1) signatureA1),
    ("CAVP SigVer15 2048/SHA-256 case A2, Result = F",
      verify keyA (bytesOfHex messageA2) signatureA2 == false),
    ("CAVP SigVer15 2048/SHA-256 case A3, Result = F",
      verify keyA (bytesOfHex messageA3) signatureA3 == false),
    ("CAVP SigVer15 2048/SHA-256 case B1, Result = P",
      verify keyB (bytesOfHex messageB1) signatureB1),
    ("CAVP SigVer15 2048/SHA-256 case B2, Result = F",
      verify keyB2 (bytesOfHex messageB2) signatureB2 == false),
    ("a signature valid for a different message is refused",
      verify keyA (bytesOfHex messageA2) signatureA1 == false),
    ("a signature valid under a different key is refused",
      verify keyB (bytesOfHex messageA1) signatureA1 == false),
    -- The length check comes before the arithmetic, and these are the two ways to miss it.
    ("a signature one byte short is refused",
      Rsa.verifyPkcs1v15 .sha256 keyA (bytesOfHex messageA1)
        ((bytesOfHex signatureA1).extract 0 255) == false),
    ("a signature one byte long is refused",
      Rsa.verifyPkcs1v15 .sha256 keyA (bytesOfHex messageA1)
        (⟨#[0x00]⟩ ++ bytesOfHex signatureA1) == false),
    ("an empty signature is refused",
      Rsa.verifyPkcs1v15 .sha256 keyA (bytesOfHex messageA1) ⟨#[]⟩ == false),
    -- A 1024-bit modulus is refused for its size, not for disagreeing: the same vector is
    -- recorded as passing in the CAVP file.
    ("a 1024-bit modulus is refused",
      verify keyShort (bytesOfHex messageShort) signatureShort == false),
    ("the fixture key's genuine signature verifies",
      verify keyCrafted messageCrafted signatureCrafted),
    ("a block whose padding is not all 0xFF is refused",
      verify keyCrafted messageCrafted signatureBadPadding == false),
    ("a block with the padding shortened and the DigestInfo shifted is refused",
      verify keyCrafted messageCrafted signatureShiftedInfo == false) ]

end Tests.RsaVectors
