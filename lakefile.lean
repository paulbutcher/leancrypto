import Lake
open System Lake DSL

package leancrypto where
  version := v!"0.1.0"
  leanOptions := #[
    ⟨`autoImplicit, false⟩,
    ⟨`relaxedAutoImplicit, false⟩,
    ⟨`warningAsError, true⟩]

/-- Two targets rather than one, so that a consumer needing only an encoding does not build a
hash function, and so that the encodings are not described as cryptography. Neither depends on
the other. -/
@[default_target]
lean_lib Crypto

@[default_target]
lean_lib Codec

@[test_driver]
script tests (args) do
  let pkg ← getRootPackage
  let child ← IO.Process.spawn {
    cmd := "lake"
    args := #["test", "--"] ++ args.toArray
    cwd := pkg.dir / "test"
  }
  child.wait
